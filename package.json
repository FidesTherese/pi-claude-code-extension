{
  "name": "pi-extension-claude-code",
  "version": "0.1.0",
  "description": "A Pi extension that gives Pi the live status style of Claude Code.",
  "type": "module",
  "private": true,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/run-tui-smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@types/node": "^24.0.0",
    "@xterm/headless": "^5.5.0",
    "typescript": "^5.9.0"
  }
}
